{
  "name": "@evidencedesk/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src playwright.config.ts vite.config.ts ../../tests/ui",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@evidencedesk/api-client": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.0.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^26",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
