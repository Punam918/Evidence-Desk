{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencedesk.invalid/schemas/chunk.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "maxLength": 12000
    },
    "page_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "page_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "heading_path": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      },
      "maxItems": 20
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "document_id",
    "revision_id",
    "text",
    "page_start",
    "page_end",
    "heading_path",
    "content_sha256"
  ]
}
