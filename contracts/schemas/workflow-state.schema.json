{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencedesk.invalid/schemas/workflow-state.schema.json",
  "title": "Reference-only graph domain state",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "intent": {
      "enum": [
        "ask",
        "compare",
        "brief"
      ]
    },
    "revision_ids": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "evidence_chunk_ids": {
      "type": "array",
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_execution_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "step": {
      "type": "string",
      "enum": [
        "authorize",
        "route",
        "retrieve",
        "context",
        "generate",
        "validate",
        "finalize",
        "abstain",
        "terminalize",
        "prepare",
        "approval",
        "reauthorize",
        "save",
        "done"
      ]
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "thread_id",
    "run_id",
    "intent",
    "revision_ids",
    "evidence_chunk_ids",
    "step",
    "config_sha256"
  ]
}
