{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provenance",
        "output"
      ],
      "properties": {
        "name": {
          "const": "search_knowledge"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_id",
            "tool_version",
            "retrieved_at",
            "payload_sha256",
            "source_revision_ids"
          ],
          "properties": {
            "execution_id": {
              "type": "string",
              "format": "uuid"
            },
            "tool_version": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_revision_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 16
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chunks",
            "degraded"
          ],
          "properties": {
            "chunks": {
              "type": "array",
              "items": {
                "$ref": "chunk.schema.json"
              },
              "maxItems": 8
            },
            "degraded": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 10
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provenance",
        "output"
      ],
      "properties": {
        "name": {
          "const": "read_passages"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_id",
            "tool_version",
            "retrieved_at",
            "payload_sha256",
            "source_revision_ids"
          ],
          "properties": {
            "execution_id": {
              "type": "string",
              "format": "uuid"
            },
            "tool_version": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_revision_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 16
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chunks"
          ],
          "properties": {
            "chunks": {
              "type": "array",
              "items": {
                "$ref": "chunk.schema.json"
              },
              "minItems": 1,
              "maxItems": 8
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provenance",
        "output"
      ],
      "properties": {
        "name": {
          "const": "compare_revisions"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_id",
            "tool_version",
            "retrieved_at",
            "payload_sha256",
            "source_revision_ids"
          ],
          "properties": {
            "execution_id": {
              "type": "string",
              "format": "uuid"
            },
            "tool_version": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_revision_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 16
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "left_revision_id",
            "right_revision_id"
          ],
          "properties": {
            "answer": {
              "$ref": "answer.schema.json"
            },
            "left_revision_id": {
              "type": "string",
              "format": "uuid"
            },
            "right_revision_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provenance",
        "output"
      ],
      "properties": {
        "name": {
          "const": "save_brief"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_id",
            "tool_version",
            "retrieved_at",
            "payload_sha256",
            "source_revision_ids"
          ],
          "properties": {
            "execution_id": {
              "type": "string",
              "format": "uuid"
            },
            "tool_version": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source_revision_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 16
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brief_id",
            "created_at"
          ],
          "properties": {
            "brief_id": {
              "type": "string",
              "format": "uuid"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  ]
}
