{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencedesk.invalid/schemas/qdrant-payload.schema.json",
  "title": "Derived point metadata; never authority or prompt evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "kb_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "workspace_id",
    "kb_id",
    "document_id",
    "revision_id",
    "profile_id",
    "text_sha256",
    "manifest_sha256"
  ]
}
