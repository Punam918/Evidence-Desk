# Specification example. No real credentials. Production rejects REPLACE_ME.
ED_ENV=development
ED_PUBLIC_ORIGIN=https://evidencedesk.local:8443
ED_DATABASE_URL=postgresql+psycopg://runtime@db/evidencedesk
ED_IDENTITY_DATABASE_URL=postgresql+psycopg://identity@db/evidencedesk
ED_DISPATCH_DATABASE_URL=postgresql+psycopg://dispatcher@db/evidencedesk
ED_OIDC_ISSUER=https://evidencedesk.local:8443/identity/realms/evidencedesk
ED_OIDC_CLIENT_ID=evidencedesk
ED_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
ED_SESSION_KEY_FILE=/run/secrets/session_key
ED_CURSOR_KEY_FILE=/run/secrets/cursor_key
ED_S3_ENDPOINT=http://s3:9000
ED_S3_REGION=us-east-1
ED_S3_BUCKET=evidencedesk-private
ED_S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
ED_S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
ED_OPENAI_KEY_FILE=/run/secrets/openai_key
ED_ANTHROPIC_KEY_FILE=/run/secrets/anthropic_key
ED_GOOGLE_KEY_FILE=/run/secrets/google_key
ED_LOCAL_MODEL_URL=http://ollama:11434
ED_LOCAL_MODEL_KEY_FILE=/run/secrets/local_model_key
ED_POLICY_CONFIG_PATH=/config/defaults.yaml
ED_MODEL_CONFIG_PATH=/config/models.yaml
ED_MODEL_CACHE_PATH=/models
# Optional private telemetry. Omit these fields to disable export/listening.
ED_OTLP_ENDPOINT=http://collector:4318/v1/traces
ED_METRICS_HOST=127.0.0.1
ED_METRICS_PORT=9108
ED_METRICS_TOKEN_FILE=/run/secrets/metrics_token
ED_MONITOR_DATABASE_URL=postgresql://ed_monitor@db/evidencedesk
ED_BACKUP_RECIPIENT=REPLACE_ME
ED_LOG_LEVEL=INFO

ED_QDRANT_URL=http://qdrant:6333
ED_QDRANT_READ_KEY_FILE=/run/secrets/qdrant_read_key
ED_QDRANT_WRITE_KEY_FILE=/run/secrets/qdrant_write_key
ED_CHECKPOINT_DATABASE_URL=postgresql://ed_checkpoint:development-only@postgres:5432/evidencedesk?options=-csearch_path%3Dlg_checkpoints
ED_QDRANT_CONFIG_PATH=contracts/config/qdrant.yaml
