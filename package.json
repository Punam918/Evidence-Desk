{
  "name": "evidencedesk",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @evidencedesk/web build",
    "test": "pnpm --filter @evidencedesk/web test",
    "typecheck": "pnpm --filter @evidencedesk/web typecheck",
    "api:generate": "openapi-typescript contracts/openapi.yaml -o packages/api-client/schema.d.ts && node scripts/generate_events.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3"
  }
}
