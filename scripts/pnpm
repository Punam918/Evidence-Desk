#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$project_root/.tools/node-v24.21.0-linux-x64/bin/node" ]]; then
  export PATH="$project_root/.tools/node-v24.21.0-linux-x64/bin:$PATH"
fi
if [[ -x "$project_root/.tools/pnpm/node_modules/.bin/pnpm" ]]; then
  export PATH="$project_root/.tools/pnpm/node_modules/.bin:$PATH"
fi
if [[ "$(node -p 'process.versions.node.split(".")[0]')" != 24 ]]; then
  echo 'Node 24 LTS is required. Install the version in .node-version.' >&2
  exit 1
fi
exec pnpm "$@"
