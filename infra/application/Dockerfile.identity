FROM quay.io/keycloak/keycloak@sha256:27b3230fbabb8c9ff3c66c864cf09dcd8a41aca82e5100679d109ef0eeb05741
RUN /opt/keycloak/bin/kc.sh build --db=postgres --health-enabled=true --http-relative-path=/identity --http-management-relative-path=/
USER 10001:10001
ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "--config-file=/run/secrets/keycloak.conf"]
CMD ["start", "--optimized", "--import-realm"]
