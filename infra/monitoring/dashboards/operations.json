      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "evidencedesk"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(ed_http_requests_total[5m]))",
          "legendFormat": "{{service}} {{stage}} {{model_key}} {{kind}} {{event}} {{route_template}} {{branch}} {{status_class}} {{direction}} {{estimated}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
