{
  "uid": "evidencedesk-operations",
  "title": "EvidenceDesk operations",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "tags": [
    "evidencedesk"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "evidencedesk"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"evidencedesk\"}",
          "legendFormat": "{{service}} {{stage}} {{model_key}} {{kind}} {{event}} {{route_template}} {{branch}} {{status_class}} {{direction}} {{estimated}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Ledger snapshot freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "evidencedesk"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ed_monitor_snapshot_success",
          "legendFormat": "{{service}} {{stage}} {{model_key}} {{kind}} {{event}} {{route_template}} {{branch}} {{status_class}} {{direction}} {{estimated}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
